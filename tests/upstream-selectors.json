{
  "_comment": [
    "Every DOM selector Bonfire's injection code aims at something it does not own.",
    "",
    "This file is the memory rule 'read the actual component before touching an injection",
    "selector' turned into something a machine checks. tests/js/selectors.test.js fails on",
    "any selector used by an injection function that is not listed here, so a new one",
    "cannot be added without someone recording what it was verified against.",
    "",
    "status:",
    "  ours     - an element Bonfire itself creates",
    "  generic  - a bare tag or attribute with no upstream dependency",
    "  runtime  - rendered by a dependency at runtime (MUI), so it is absent from",
    "             jellyfin-web's source and grepping for it there proves nothing",
    "  theme    - deliberately aimed at third-party skins, not at stock jellyfin-web",
    "  upstream - present in jellyfin-web, in the file named by 'source'",
    "  dead     - aimed at stock jellyfin-web and NOT present in it",
    "",
    "Refresh the upstream/dead verdicts with: node tests/js/selectors.verify.js",
    "(that one needs network; the test does not)."
  ],
  "verifiedAgainst": "jellyfin/jellyfin-web@release-10.11.z",
  "verifiedOn": "2026-08-27",

  "selectors": [
    { "selector": "#profiles-gate-overlay", "status": "ours" },
    { "selector": "#profiles-preferences-menu-item", "status": "ours" },
    { "selector": "#profiles-user-menu-item", "status": "ours" },
    { "selector": "#profiles-userprofile-switch-btn", "status": "ours" },
    { "selector": "#profiles-floating-bubble", "status": "ours" },
    { "selector": "[id^=\"profiles-\"][id$=\"-dialog\"]", "status": "ours",
      "note": "Two unqualified attribute selectors. P3-3 replaces this with a tracked list." },

    { "selector": "a", "status": "generic" },
    { "selector": "div", "status": "generic" },
    { "selector": "span", "status": "generic" },
    { "selector": "nav", "status": "generic" },
    { "selector": "ul", "status": "generic" },
    { "selector": "button", "status": "generic" },
    { "selector": "form", "status": "generic" },
    { "selector": "a[href]", "status": "generic" },
    { "selector": "a[role=\"button\"]", "status": "generic" },
    { "selector": "[data-id]", "status": "generic" },
    { "selector": "button:not(#profiles-floating-bubble)", "status": "generic",
      "note": "Geometric header fallback: any button except our own, so the bubble cannot anchor to itself." },
    { "selector": "a[role=\"button\"]:not(#profiles-floating-bubble)", "status": "generic" },

    { "selector": "li.MuiMenuItem-root", "status": "runtime", "source": "@mui/material/MenuItem" },
    { "selector": ".MuiListItemIcon-root", "status": "runtime", "source": "@mui/material/ListItemIcon" },
    { "selector": ".MuiListItemText-root", "status": "runtime", "source": "@mui/material/ListItemText" },
    { "selector": ".MuiListItemText-primary", "status": "runtime", "source": "@mui/material/ListItemText" },
    { "selector": "#app-user-menu .MuiBackdrop-root", "status": "runtime", "source": "@mui/material/Modal" },
    { "selector": ".MuiModal-root .MuiBackdrop-root", "status": "runtime", "source": "@mui/material/Modal" },
    { "selector": "[role=\"menuitem\"]", "status": "runtime", "source": "@mui/material/MenuItem" },
    { "selector": "[data-testid=\"LogoutIcon\"]", "status": "runtime",
      "source": "@mui/icons-material/Logout",
      "note": "AppUserMenu.tsx imports Logout from @mui/icons-material and renders <Logout />; MUI stamps data-testid=\"LogoutIcon\" on it. Absent from jellyfin-web source but present at runtime. Checked FIRST, before any text match, because issue #14 arrived with a Polish screenshot." },

    { "selector": ".skinHeader", "status": "upstream", "source": "src/apps/experimental/routes/home.tsx" },
    { "selector": ".headerRight", "status": "upstream", "source": "src/scripts/libraryMenu.js" },
    { "selector": ".navMenu", "status": "upstream", "source": "src/scripts/libraryMenu.js",
      "note": "Present as the navMenuOption/navMenuOptionText prefix, NOT as a container class. The drawer container is .mainDrawer with a .scrollContainer inside it." },
    { "selector": "#app-user-menu", "status": "upstream", "source": "src/components/toolbar/AppUserMenu.tsx" },
    { "selector": "#myPreferencesMenuPage", "status": "upstream", "source": "src/apps/experimental/AppOverrides.scss" },
    { "selector": "#userProfilePage", "status": "upstream", "source": "src/apps/stable/routes/user/userprofile.tsx" },
    { "selector": ".userProfilePage", "status": "upstream", "source": "src/apps/stable/routes/user/userprofile.tsx" },
    { "selector": ".btnLogout", "status": "upstream", "source": "src/apps/stable/routes/user/settings/index.tsx" },
    { "selector": ".userSection .btnLogout", "status": "upstream",
      "source": "src/apps/stable/routes/user/settings/index.tsx",
      "note": "Both halves are in this one file — it is the only place upstream where they co-occur, which is what makes the descendant selector meaningful." },
    { "selector": ".listItem", "status": "upstream", "source": "src/apps/stable/routes/user/settings/index.tsx" },
    { "selector": ".listItemIcon", "status": "upstream", "source": "src/apps/stable/routes/user/settings/index.tsx" },
    { "selector": ".listItemBodyText", "status": "upstream", "source": "src/apps/stable/routes/user/settings/index.tsx" },
    { "selector": ".readOnlyContent", "status": "upstream", "source": "src/apps/dashboard/controllers/livetvguideprovider.html" },
    { "selector": ".padded-left", "status": "upstream", "source": "src/apps/experimental/components/library/ItemsView.tsx" },
    { "selector": ".page", "status": "upstream", "source": "src/apps/dashboard/AppOverrides.scss" },
    { "selector": ".card", "status": "upstream", "source": "src/apps/dashboard/components/BaseCard.tsx" },
    { "selector": ".drawer-open", "status": "upstream", "source": "src/lib/navdrawer/navdrawer.js" },

    { "selector": "[class*=\"skinHeader\"]", "status": "theme",
      "note": "Substring match for skins that rename the header. Deliberate, and it is why the fast path failing is survivable." },
    { "selector": "[class*=\"topBar\"]", "status": "theme", "note": "Same, for skins using a topBar naming." },
    { "selector": ".jellyfinHeader", "status": "theme", "note": "ElegantFin and similar." },

    { "selector": ".sidebar-nav", "status": "dead", "trackedBy": "P3-2",
      "note": "injectSidebarLink. Zero hits anywhere in jellyfin-web. The drawer is .mainDrawer > .scrollContainer with .navMenuOption rows. This function cannot fire on 10.11 and runs twice a second." },
    { "selector": ".headerRightButtons", "status": "dead", "trackedBy": "P3-2", "note": "_findHeaderContainer Strategy A." },
    { "selector": ".headerSelfView", "status": "dead", "trackedBy": "P3-2", "note": "_findHeaderContainer Strategy A." },
    { "selector": ".headerButtons-right", "status": "dead", "trackedBy": "P3-2", "note": "_findHeaderContainer Strategy A." },
    { "selector": ".viewHeaderRight", "status": "dead", "trackedBy": "P3-2", "note": "_findHeaderContainer Strategy A." },
    { "selector": ".skinHeader-rightButtons", "status": "dead", "trackedBy": "P3-2", "note": "_findHeaderContainer Strategy A. Note .skinHeader itself IS upstream; this hyphenated variant is not." },
    { "selector": ".btnCurrentUser", "status": "dead", "trackedBy": "P3-2", "note": "_findHeaderContainer Strategy B." },
    { "selector": ".headerButtonUser", "status": "dead", "trackedBy": "P3-2", "note": "_findHeaderContainer Strategy B." },
    { "selector": ".headerButton-user", "status": "dead", "trackedBy": "P3-2", "note": "_findHeaderContainer Strategy B." },
    { "selector": ".appdrawer-mask", "status": "dead", "trackedBy": "P3-2", "note": "Used when hiding shadow profiles. Not in 10.11." }
  ]
}
