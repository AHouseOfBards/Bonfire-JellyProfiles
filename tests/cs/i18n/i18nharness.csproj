<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Which build of the plugin this harness loads, and therefore which runtime it
         must itself run on: a net9 harness cannot load the net10 assembly. Defaults to
         net9.0, the one that ships. tests/run.sh cs10 runs the whole set against the
         other one. -->
    <BonfireTfm Condition="'$(BonfireTfm)' == ''">net9.0</BonfireTfm>
    <TargetFramework>$(BonfireTfm)</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>i18nharness</AssemblyName>
    <RootNamespace>i18nharness</RootNamespace>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Needed at runtime, not just to compile: invoking ReadLocaleJson reaches
       typeof(Plugin), and loading that type loads its BasePlugin base from
       MediaBrowser.Common. The plugin itself excludes these at runtime because the server
       supplies them; a harness has no server. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Common" Version="10.11.5" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.5" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Jellyfin.Profiles">
      <HintPath>$(MSBuildThisFileDirectory)..\..\..\bin\Release\$(BonfireTfm)\Jellyfin.Profiles.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
