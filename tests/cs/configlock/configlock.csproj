<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Which build of the plugin this harness loads, and therefore which runtime it
         must itself run on: a net9 harness cannot load the net10 assembly. Defaults to
         net9.0, the one that ships. tests/run.sh cs10 runs the whole set against the
         other one. -->
    <BonfireTfm Condition="'$(BonfireTfm)' == ''">net9.0</BonfireTfm>
    <TargetFramework>$(BonfireTfm)</TargetFramework>
    <Nullable>disable</Nullable>
    <AssemblyName>configlockharness</AssemblyName>
    <RootNamespace>configlockharness</RootNamespace>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Unlike the plugin, this harness needs MediaBrowser.Common at *runtime*: it reads the
       IL of BasePlugin<T>.UpdateConfiguration to prove the configuration instance really is
       replaced. So no ExcludeAssets here — the DLL must land in the output folder. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Common" Version="10.11.5" />
    <PackageReference Include="Jellyfin.Model" Version="10.11.5" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Jellyfin.Profiles">
      <HintPath>$(MSBuildThisFileDirectory)..\..\..\bin\Release\$(BonfireTfm)\Jellyfin.Profiles.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
