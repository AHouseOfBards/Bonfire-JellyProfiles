<Project Sdk="Microsoft.NET.Sdk">
  <!-- Exists only to be published: it pulls one release of the Jellyfin packages, and everything they depend on,
       into a folder for binchk to resolve against. The release comes from -p:JfVersion. -->
  <PropertyGroup>
    <TargetFramework Condition="$(JfVersion.StartsWith('10.'))">net9.0</TargetFramework>
    <TargetFramework Condition="!$(JfVersion.StartsWith('10.'))">net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JfVersion)" />
    <PackageReference Include="Jellyfin.Model" Version="$(JfVersion)" />
    <PackageReference Include="Jellyfin.Common" Version="$(JfVersion)" />
  </ItemGroup>
</Project>
