<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Profiles</AssemblyName>
    <RootNamespace>Jellyfin.Profiles</RootNamespace>
    <Version>1.2.11</Version>
    <!-- Jellyfin requires a purely numeric assembly version, so the pre-release label
         lives here. The plugin reports this string in the API and the dashboard badge,
         which is how users can tell a beta build from a finished one at a glance.
         Drop the "-beta" suffix when promoting a release to stable. -->
    <InformationalVersion>1.2.11-beta</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.5">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.5">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Common" Version="10.11.5">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="scratch\**" />
    <EmbeddedResource Remove="scratch\**" />
    <None Remove="scratch\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/profilesDashboard.html" />
    <EmbeddedResource Include="Web/profiles.js" />
  </ItemGroup>

</Project>
