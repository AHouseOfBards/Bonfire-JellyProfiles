<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Two runtimes, one source. Jellyfin 10.11.x runs on .NET 9 and 12.0 runs on .NET 10,
         and a net9 assembly does load on the .NET 10 runtime — that is what 1.6.0.1 through
         1.6.1 shipped and it is confirmed working on a live 12.0 server. But that is the
         runtime being tolerant, not a promise, so net10.0 is built and tested alongside it
         and is ready the day it is needed.
         net9.0 is still what ships: it is the only one of the two that serves BOTH servers,
         so one artefact and one manifest entry covers everybody. See the packaging step in
         release.yml, which names net9.0 deliberately. -->
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Profiles</AssemblyName>
    <RootNamespace>Jellyfin.Profiles</RootNamespace>
    <Version>1.6.1.9</Version>
    <!-- Jellyfin requires a purely numeric assembly version, so any pre-release label lives
         here instead. The plugin reports this string in the API and the dashboard badge, and
         the settings page shows a pre-release notice whenever it matches -beta/-alpha/-rc.
         STABLE RELEASE: no suffix. Append "-beta" here (and only here) to mark a build as
         pre-release; nothing else needs changing. -->
    <InformationalVersion>1.6.1.9-beta</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.11.5">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.5">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Common" Version="10.11.5">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- JsonDefaults, so anything we add to a Jellyfin API response is serialized by
         Jellyfin's own rules rather than System.Text.Json's defaults. Its nine converters
         are not decoration: without them enums become integers and Guids grow dashes, and
         a client that parses one of those crashes. Byte-identical between 10.11 and 12.0,
         and runtime-excluded like the rest — the server supplies its own copy. -->
    <PackageReference Include="Jellyfin.Extensions" Version="10.11.5">
      <PrivateAssets>all</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The SDK globs **/*.cs, so anything under these would be compiled into the plugin.
       tests\ holds four standalone harness projects; without this the plugin build picks
       up their Program.cs files and fails on duplicate assembly attributes. -->
  <ItemGroup>
    <Compile Remove="scratch\**" />
    <EmbeddedResource Remove="scratch\**" />
    <None Remove="scratch\**" />
    <Compile Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/profilesDashboard.html" />
    <EmbeddedResource Include="Web/profiles.js" />
    <!-- Spliced into profiles.js as it is served, by ProfilesController.PublishStyles.
         A real .css file rather than a template literal inside the script: that is what
         makes the 1.5.2 failure impossible at the language level. -->
    <EmbeddedResource Include="Web/styles.css" />
    <EmbeddedResource Include="Web/i18n/*.json" />
  </ItemGroup>

</Project>
